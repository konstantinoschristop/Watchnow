    "Watchnow can tell you the day something you saved is finally watchable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchnow kann dir Bescheid sagen, sobald etwas Gemerktes endlich verfügbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Watchnow μπορεί να σε ειδοποιεί τη μέρα που κάτι από όσα αποθήκευσες γίνεται επιτέλους διαθέσιμο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchnow puede avisarte el día en que por fin puedas ver algo que hayas guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchnow peut vous prévenir le jour où un titre enregistré devient enfin disponible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watchnow pode avisar no dia em que algo que você salvou finalmente estiver disponível para assistir."
          }
        }
      }
    },
    "We couldn't load the services for your region. You can set them later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten die Dienste für deine Region nicht laden. Du kannst sie später in den Einstellungen festlegen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορέσαμε να φορτώσουμε τις υπηρεσίες για την περιοχή σου. Μπορείς να τις ορίσεις αργότερα στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos cargar las plataformas de tu región. Puedes elegirlas más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les services de votre région. Vous pourrez les choisir plus tard dans les réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar os serviços da sua região. Você pode escolhê-los depois em Ajustes."
          }
        }
      }
    },
    "We'll only suggest what you can actually watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir schlagen dir nur vor, was du dir auch wirklich ansehen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σου προτείνουμε μόνο ό,τι μπορείς πραγματικά να δεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo te sugeriremos lo que de verdad puedas ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne vous proposerons que ce que vous pouvez vraiment regarder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só sugerimos o que você pode assistir de verdade."
          }
        }
      }
    },
    "We'll use this to tell you when something you saved lands somewhere you can actually watch it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit sagen wir dir Bescheid, wenn etwas Gemerktes dort landet, wo du es dir auch wirklich ansehen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έτσι θα σε ειδοποιούμε όταν κάτι που αποθήκευσες φτάνει κάπου όπου μπορείς πραγματικά να το δεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usaremos para avisarte cuando algo que hayas guardado llegue a una plataforma donde de verdad puedas verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela nous permettra de vous prévenir quand un titre enregistré arrive là où vous pouvez vraiment le regarder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com isso, avisamos quando algo que você salvou chegar a um lugar onde você possa assistir."
          }
        }
      }
    },

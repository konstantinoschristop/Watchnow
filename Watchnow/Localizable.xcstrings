    "Enable notifications for Watchnow in Settings to set episode reminders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere in den Einstellungen Mitteilungen für Watchnow, um an neue Folgen erinnert zu werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να ορίσεις υπενθυμίσεις επεισοδίων, ενεργοποίησε τις γνωστοποιήσεις για το Watchnow στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las notificaciones de Watchnow en Ajustes para crear recordatorios de episodios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les notifications de Watchnow dans Réglages pour programmer des rappels d’épisode."

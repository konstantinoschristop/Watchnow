    "Choose Watchnow's language in iOS Settings. Titles and synopses follow it too." : {
      "comment" : "Settings footer under the Language row",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Sprache von Watchnow in den iOS-Einstellungen. Titel und Beschreibungen erscheinen dann ebenfalls in dieser Sprache."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε τη γλώσσα του Watchnow στις Ρυθμίσεις του iOS. Στην ίδια γλώσσα εμφανίζονται και οι τίτλοι και οι περιλήψεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el idioma de Watchnow en Ajustes de iOS. Los títulos y las sinopsis también se mostrarán en ese idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la langue de Watchnow dans l’app Réglages. Les titres et les résumés s’affichent aussi dans cette langue."

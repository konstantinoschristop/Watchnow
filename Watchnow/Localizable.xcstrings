    "%@ is on a service you have. Fancy it tonight?" : {
      "comment" : "Notification body",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft bei einem deiner Dienste. Wie wär’s heute Abend?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: είναι σε μια από τις υπηρεσίες σου. Τι λες για απόψε;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está en una de tus plataformas. ¿Qué tal esta noche?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est disponible sur l’un de vos services. Ça vous dit ce soir ?"
